# PHP 8.1+ / MySQL or MariaDB
CHEMNAMA_DB_HOST=127.0.0.1
CHEMNAMA_DB_PORT=3306
CHEMNAMA_DB_NAME=tata_senyawa
CHEMNAMA_DB_USER=root
CHEMNAMA_DB_PASS=
# Set 0 on hosting; create database in hosting control panel first.
CHEMNAMA_DB_AUTO_CREATE=1
# Set 1 on HTTPS hosting; 0 for HTTP localhost.
CHEMNAMA_SESSION_SECURE=0
# Required for teacher registration: generate a private random invitation code.
# Empty disables teacher registration.
CHEMNAMA_GURU_ACCESS_CODE=
# Empty allows open student registration.
CHEMNAMA_SISWA_ACCESS_CODE=
CHEMNAMA_DEBUG_MODE=0
# Optional SMTP for password recovery with existing PHPMailer.
CHEMNAMA_SMTP_HOST=
CHEMNAMA_SMTP_PORT=587
CHEMNAMA_SMTP_USERNAME=
CHEMNAMA_SMTP_PASSWORD=
CHEMNAMA_SMTP_ENCRYPTION=tls
CHEMNAMA_SMTP_FROM_EMAIL=
CHEMNAMA_SMTP_FROM_NAME=Nom Comp